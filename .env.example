# Deployer key for Hardhat only. Never put this in the frontend or commit a real key.
# Use a dedicated Avalanche Fuji testnet wallet. This is NOT your Core Wallet seed phrase.
PRIVATE_KEY=
AVALANCHE_TESTNET_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Frontend contract addresses. `npm run contracts:deploy` also writes src/config/deployed.json.
VITE_CHECKIN_EVENTS_CONTRACT=
VITE_CHECKIN_TICKETS_CONTRACT=
VITE_CHECKIN_REWARDS_CONTRACT=
VITE_AVALANCHE_TESTNET_RPC=https://api.avax-test.network/ext/bc/C/rpc
VITE_DEPLOY_BLOCK=

# Firebase web config. These values are public in the browser bundle.
# Leave them blank for the local emulator (the app falls back to project id checkin-local).
# Set them from the Firebase console before a production build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true uses the Firestore emulator. `npm run dev` already does that unless this is false.
VITE_FIREBASE_USE_EMULATOR=
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Metadata server. Blank credentials use the Firestore emulator on 127.0.0.1:8080.
# Do not commit a service account. Paste the JSON on one line, or point at a file outside the repo.
FIREBASE_PROJECT_ID=checkin-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
